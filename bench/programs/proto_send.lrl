;; Benchmark workload proto_send: open a protocol channel for n messages, send the n elements of a
;; Vec Nat n built at run time with the case study's send_all (dependent elimination of the vector,
;; one FnOnce closure per element), close it, and sum the receipt's log with `total`.
;; Every element is 1, so the result is n.
;; Difference from protocol.lrl: the send operation is generated by the same `defsend` macro, but
;; with the non-printing encoder `quiet` instead of the printing `log`, so that the measurement
;; does not time n lines of output.
;; @SIZE@ is replaced by the driver (bench/run_bench.py) with `(nat_mul A B)` for small literals
;; A and B, so that n is computed at run time instead of being written as one large unary literal.
;;
;; The workload is a function of n and `main` applies it to `size`: the vector length is then the
;; variable n inside `workload`. (When a closed size expression appears in a type index, e.g.
;; `(def main Nat (vsum (vbuild size)))`, the compiler evaluates it in unary while lowering to
;; MIR; see bench/README.md, "Compile-time evaluation of indices".)
;;
;; The forms named on the @copied-from line are copied verbatim from the case study;
;; `python3 bench/run_bench.py check` verifies that they are still identical to it.
;; @copied-from case_studies/lrl/protocol.lrl: Vec Chan Receipt open_chan close defsend send_all log_sum total

(inductive Vec (pi A (sort 1) (pi n Nat (sort 1)))
  (ctor vnil (pi {A (sort 1)} (Vec A zero)))
  (ctor vcons (pi {A (sort 1)} (pi {n Nat} (pi h A (pi t (Vec A n) (Vec A (succ n))))))))

(inductive (affine) Chan (pi n Nat (sort 1))
  (ctor mk_chan (pi {n Nat} (pi log (List Nat) (Chan n)))))

(inductive Receipt (sort 1)
  (ctor receipt (pi log (List Nat) Receipt)))

(def open_chan (pi n Nat (Chan n))
  (lam n Nat (mk_chan nil)))

(def close (pi c (Chan zero) Receipt)
  (lam c (Chan zero)
    (match c Receipt (case (mk_chan log) (receipt log)))))

(defmacro defsend (name payload encode)
  (def name (pi {n Nat} (pi c (Chan (succ n)) (pi #[once] x payload (Chan n))))
    (lam {n} Nat (lam c (Chan (succ n)) (lam #[once] x payload
      (match c (Chan n)
        (case (mk_chan log) (mk_chan (cons (encode x) log)))))))))


(def quiet (pi m Nat Nat) (lam m Nat m))
(defsend send Nat quiet)

(def send_all (pi {n Nat} (pi v (Vec Nat n) (pi #[once] c (Chan n) Receipt)))
  (lam {n} Nat (lam v (Vec Nat n)
    (match v (motive (lam k Nat (lam w (Vec Nat k) (pi #[once] c (Chan k) Receipt))))
      (case (vnil) close)
      (case (vcons h t ih) (lam #[once] c (Chan (succ _)) (ih (send c h))))))))

(def log_sum (pi l (List Nat) Nat)
  (lam l (List Nat) (match l Nat (case (nil) zero) (case (cons x rest ih) (add x ih)))))

(def total (pi r Receipt Nat)
  (lam r Receipt (match r Nat (case (receipt l) (log_sum l)))))

;; ---- workload ----
(def vbuild (pi n Nat (Vec Nat n))
  (lam n Nat
    (match n (motive (lam k Nat (Vec Nat k)))
      (case (zero) vnil)
      (case (succ k ih) (vcons 1 ih)))))

(def size Nat @SIZE@)

(def workload (pi n Nat Nat)
  (lam n Nat (total (send_all (vbuild n) (open_chan n)))))

(def main Nat (workload size))
