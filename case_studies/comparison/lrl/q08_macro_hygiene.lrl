;; Q8 (positive): hygienic macros that generate typed operations. For a unit name, `defunit`
;; generates the unit type (an inductive wrapping a Nat), `defadd` its typed addition and
;; `defval` its projection to Nat (a macro expands to one top-level form, hence three macros).
;; They are used for Meters and Seconds.
;; `with_tmp` checks hygiene: its template binds `tmp` to 100 and adds the user's expression;
;; the user passes their own variable `tmp` (= 1). A hygienic expansion gives 100 + 1 = 101;
;; if the template's binder captured the user's `tmp`, the result would be 100 + 100 = 200.
(defmacro defunit (T mk) (inductive T (sort 1) (ctor mk (pi v Nat T))))
(defmacro defadd (T mk op)
  (def op (pi a T (pi b T T))
    (lam a T (lam b T
      (match a T (case (mk x) (match b T (case (mk y) (mk (add x y))))))))))
(defmacro defval (T mk val) (def val (pi u T Nat) (lam u T (match u Nat (case (mk x) x)))))

(defunit Meters meters)
(defadd Meters meters meters_add)
(defval Meters meters meters_val)
(defunit Seconds seconds)
(defadd Seconds seconds seconds_add)
(defval Seconds seconds seconds_val)

(defmacro with_tmp (e) (let tmp Nat 100 (add tmp e)))

(def main Nat
  (add (print_nat (meters_val (meters_add (meters 3) (meters 4))))        ;; 7
  (add (print_nat (seconds_val (seconds_add (seconds 5) (seconds 6))))   ;; 11
       (print_nat (let tmp Nat 1 (with_tmp tmp))))))                     ;; 101 (hygienic)
