;; Class 06 - the repeated (succ) case of a match on Nat consumes a captured
;; owned value. The succ case runs once per `succ` of `n`, so the token `k`
;; would be moved once per iteration.
;; Expected: kernel K0021 [ConsumedInRepeatedScope] naming `k`.
(inductive (affine) Tok (sort 1) (ctor mk_tok (pi id Nat Tok)))
(inductive TL (sort 1) (ctor tnil TL) (ctor tcons (pi h Tok (pi t TL TL))))

(def spread (pi k Tok (pi #[once] n Nat TL))
  (lam k Tok (lam #[once] n Nat
    (match n TL
      (case (zero) tnil)
      (case (succ m ih) (tcons k ih))))))
