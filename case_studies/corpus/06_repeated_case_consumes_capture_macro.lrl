;; Class 06 (macro twin) - `replicate-into` expands to the same match; the
;; template's pattern binders `m` and `ih` are hygienic.
;; Expected: kernel K0021 [ConsumedInRepeatedScope] naming `k`.
(inductive (affine) Tok (sort 1) (ctor mk_tok (pi id Nat Tok)))
(inductive TL (sort 1) (ctor tnil TL) (ctor tcons (pi h Tok (pi t TL TL))))

(defmacro replicate-into (tok count)
  `(match ,count TL
     (case (zero) tnil)
     (case (succ m ih) (tcons ,tok ih))))

(def spread (pi k Tok (pi #[once] n Nat TL))
  (lam k Tok (lam #[once] n Nat (replicate-into k n))))
