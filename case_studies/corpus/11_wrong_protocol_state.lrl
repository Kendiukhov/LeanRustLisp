;; Class 11 - an operation applied in the wrong protocol state (a type error,
;; not an ownership error). The affine `Door` is indexed by its state;
;; `close` requires an open door, but `bad` closes a door that is already
;; closed.
;; Expected: elaborator type error (F0205 TypeMismatch or F0214 UnificationError).
(inductive St (sort 1) (ctor opened St) (ctor closed St))
(inductive (affine) Door (pi s St (sort 1))
  (ctor mk_open (Door opened))
  (ctor mk_closed (Door closed)))

(def open_door (Door opened) mk_open)
(def close (pi d (Door opened) (Door closed))
  (lam d (Door opened) mk_closed))

(def bad (Door closed) (close (close open_door)))
