;; Class 20 - two mutable borrows of the same value stored in two structs
;; that are both live. The kernel sees two mutable uses (no moves); MIR's
;; NLL check sees the first loan still held by `a` when the second is taken.
;; Expected: MIR M200 (ConflictingBorrow).
(inductive (affine) Tok (sort 1) (ctor mk_tok (pi n Nat Tok)))
(def poke (pi r (Ref #[r] Mut Tok) Nat) (lam r (Ref #[r] Mut Tok) (succ zero)))

(inductive MB (sort 1) (ctor mb (pi r (Ref #[r] Mut Tok) MB)))
(def pokeb (pi b MB Nat) (lam b MB (match b Nat (case (mb r) (poke r)))))

(def f (pi t Tok Nat)
  (lam t Tok
    (let a MB (mb (&mut t))
      (let b MB (mb (&mut t))
        (add (pokeb a) (pokeb b))))))
