;; Positive control P02 (nearest legal variant of class 13) - the shared
;; borrow `r` is last used before `t` is moved (non-lexical lifetimes).
;; Expected: accepted; main = 3.
(inductive (affine) Tok (sort 1) (ctor mk_tok (pi id Nat Tok)))
(def look (pi r (Ref #[r] Shared Tok) Nat) (lam r (Ref #[r] Shared Tok) (succ zero)))
(def eat (pi t Tok Nat) (lam t Tok (succ (succ zero))))

(def bdc (pi t Tok Nat)
  (lam t Tok
    (let r (Ref #[r] Shared Tok) (& t)
      (let n Nat (look r)
        (add n (eat t))))))

(def main Nat (bdc (mk_tok 0)))
