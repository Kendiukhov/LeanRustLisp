;; Positive control P05 (nearest legal variant of class 06) - the BASE case
;; of a linear recursion runs exactly once, so it may consume the captured
;; token; the succ case only passes the induction hypothesis on.
;; Expected: accepted; main = 1 (the list holds one token).
(inductive (affine) Tok (sort 1) (ctor mk_tok (pi id Nat Tok)))
(inductive TL (sort 1) (ctor tnil TL) (ctor tcons (pi h Tok (pi t TL TL))))

(def at_end (pi k Tok (pi #[once] n Nat TL))
  (lam k Tok (lam #[once] n Nat
    (match n TL
      (case (zero) (tcons k tnil))
      (case (succ m ih) ih)))))

(def tlen (pi l TL Nat)
  (lam l TL (match l Nat (case (tnil) zero) (case (tcons h t ih) (succ ih)))))

(def main Nat (tlen (at_end (mk_tok 7) 3)))
