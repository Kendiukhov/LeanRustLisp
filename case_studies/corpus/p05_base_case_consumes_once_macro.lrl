;; Positive control P05 (macro twin) - `put-at-end` expands to the match.
;; Expected: accepted; main = 1.
(inductive (affine) Tok (sort 1) (ctor mk_tok (pi id Nat Tok)))
(inductive TL (sort 1) (ctor tnil TL) (ctor tcons (pi h Tok (pi t TL TL))))

(defmacro put-at-end (tok count)
  `(match ,count TL
     (case (zero) (tcons ,tok tnil))
     (case (succ m ih) ih)))

(def at_end (pi k Tok (pi #[once] n Nat TL))
  (lam k Tok (lam #[once] n Nat (put-at-end k n))))

(def tlen (pi l TL Nat)
  (lam l TL (match l Nat (case (tnil) zero) (case (tcons h t ih) (succ ih)))))

(def main Nat (tlen (at_end (mk_tok 7) 3)))
