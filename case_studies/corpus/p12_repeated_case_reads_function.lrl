;; Positive control P12 (nearest legal variant of class 06) - the repeated
;; succ case CALLS a captured Fn function on every iteration (a read, not a
;; move), so the kernel and MIR accept it.
;; Expected: accepted; main = 3 (succ applied three times to zero).
(def iter (pi f (pi x Nat Nat) (pi #[once] n Nat Nat))
  (lam f (pi x Nat Nat) (lam #[once] n Nat
    (match n Nat
      (case (zero) zero)
      (case (succ m ih) (f ih))))))

(def main Nat (iter succ 3))
