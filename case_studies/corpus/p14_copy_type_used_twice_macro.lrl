;; Positive control P14 (macro twin) - `pair-of` duplicates its argument (as
;; in 01_double_use_macro.lrl), but `Tok` is Copy here.
;; Expected: accepted; main = 14.
(inductive Tok (sort 1) (ctor mk_tok (pi id Nat Tok)))
(inductive TP (sort 1) (ctor mk_tp (pi a Tok (pi b Tok TP))))

(defmacro pair-of (x) `(mk_tp ,x ,x))

(def dup (pi t Tok TP)
  (lam t Tok (pair-of t)))

(def val (pi t Tok Nat) (lam t Tok (match t Nat (case (mk_tok i) i))))
(def total (pi p TP Nat) (lam p TP (match p Nat (case (mk_tp a b) (add (val a) (val b))))))

(def main Nat (total (dup (mk_tok 7))))
