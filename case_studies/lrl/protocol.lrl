;; Case study B: a protocol channel tied to a vector, with macro-generated operations.
;;
;; `Chan n` is a channel on which exactly n more messages may be sent.  It is `affine`: a
;; channel value can be used at most once, so every operation consumes its channel and
;; returns the channel for the next protocol state.  `send` (generated by the hygienic macro
;; `defsend`) needs a `Chan (succ n)` and returns a `Chan n`; `close` needs a `Chan zero`.
;; `send_all` sends every element of a `Vec Nat n` over a `Chan n` and closes it: the length
;; of the data and the length of the protocol are the same number n.
;;
;; Run from the repository root (see README.md, section B, for the recorded outputs):
;;   lrl run case_studies/lrl/protocol.lrl --backend typed
;;   lrl compile case_studies/lrl/protocol.lrl --backend dynamic -o build/protocol && build/protocol

;; ---------------------------------------------------------------------------------------------
;; Length-indexed vectors.
(inductive Vec (pi A (sort 1) (pi n Nat (sort 1)))
  (ctor vnil (pi {A (sort 1)} (Vec A zero)))
  (ctor vcons (pi {A (sort 1)} (pi {n Nat} (pi h A (pi t (Vec A n) (Vec A (succ n))))))))

;; ---------------------------------------------------------------------------------------------
;; The channel. It records the messages sent so far in a `List Nat` log, newest first.
;; `(affine)`: no Copy instance is derived, so a channel cannot be duplicated (its log, a
;; `List Nat`, is Copy and is read out of the channel when it is closed or extended).
(inductive (affine) Chan (pi n Nat (sort 1))
  (ctor mk_chan (pi {n Nat} (pi log (List Nat) (Chan n)))))

;; Closing a channel yields a receipt holding the complete log.
(inductive Receipt (sort 1)
  (ctor receipt (pi log (List Nat) Receipt)))

(def open_chan (pi n Nat (Chan n))
  (lam n Nat (mk_chan nil)))

(def close (pi c (Chan zero) Receipt)
  (lam c (Chan zero)
    (match c Receipt (case (mk_chan log) (receipt log)))))

;; ---------------------------------------------------------------------------------------------
;; Send operations, generated by a macro.
;;
;; (defsend NAME PAYLOAD ENCODE) defines
;;   NAME : {n : Nat} -> Chan (succ n) -> PAYLOAD -> Chan n
;; which records (ENCODE x) in the log.  The function returned after the channel argument
;; owns the channel, so its kind is #[once] (FnOnce).
;; The template binds n, c, x and log.  These binders are hygienic: they are invisible to the
;; macro's arguments (PAYLOAD, ENCODE), which keep the meaning they have at the call site.
(defmacro defsend (name payload encode)
  (def name (pi {n Nat} (pi c (Chan (succ n)) (pi #[once] x payload (Chan n))))
    (lam {n} Nat (lam c (Chan (succ n)) (lam #[once] x payload
      (match c (Chan n)
        (case (mk_chan log) (mk_chan (cons (encode x) log)))))))))

;; A user-level logging helper: prints a message and returns it.  It is deliberately called
;; `log`, like the template's pattern variable for the channel's history.  In `send` below the
;; argument `log` still denotes this function: without hygiene it would be captured by the
;; template's `log : List Nat`, and `(log x)` would not type-check
;; (see neg/protocol_capture_by_hand.lrl).
(def log (pi m Nat Nat) (lam m Nat (print_nat m)))

(def bit (pi b Bool Nat)
  (lam b Bool (match b Nat (case (true) 1) (case (false) 0))))

(defsend send Nat log)
(defsend send_bit Bool bit)

;; ---------------------------------------------------------------------------------------------
;; Sending a whole vector: dependent elimination of `v` with the motive
;;   k, _ |-> (Chan k -> Receipt)          (an FnOnce function type)
;; For the empty vector the motive is `Chan zero -> Receipt`: that is `close`.  The vcons case
;; returns a closure that sends the head on its channel and passes the resulting channel to the
;; induction hypothesis `ih : Chan k -> Receipt` for the tail.  (`_` is the tail's length,
;; which the pattern does not name.)  The closure consumes `c` and calls the FnOnce `ih`, so it
;; is #[once] itself.
(def send_all (pi {n Nat} (pi v (Vec Nat n) (pi #[once] c (Chan n) Receipt)))
  (lam {n} Nat (lam v (Vec Nat n)
    (match v (motive (lam k Nat (lam w (Vec Nat k) (pi #[once] c (Chan k) Receipt))))
      (case (vnil) close)
      (case (vcons h t ih) (lam #[once] c (Chan (succ _)) (ih (send c h))))))))

;; ---------------------------------------------------------------------------------------------
;; A branching protocol step: send the reading `x` if it is valid, otherwise a 0 flag.  The
;; channel is consumed in BOTH branches.  Bool is not recursive, so the cases of the match are
;; alternatives (exactly one runs) and each of them may move `c`.
(def send_checked
  (pi {n Nat} (pi c (Chan (succ n)) (pi #[once] ok Bool (pi #[once] x Nat (Chan n)))))
  (lam {n} Nat (lam c (Chan (succ n)) (lam #[once] ok Bool (lam #[once] x Nat
    (match ok (Chan n)
      (case (true) (send c x))
      (case (false) (send_bit c false))))))))

;; ---------------------------------------------------------------------------------------------
;; Reading a receipt: the sum of the logged messages.
(def log_sum (pi l (List Nat) Nat)
  (lam l (List Nat) (match l Nat (case (nil) zero) (case (cons x rest ih) (add x ih)))))

(def total (pi r Receipt Nat)
  (lam r Receipt (match r Nat (case (receipt l) (log_sum l)))))

;; ---------------------------------------------------------------------------------------------
;; Session 1: a channel for exactly 3 messages, fed by a 3-element vector; `send` prints each
;; message (7, 8, 9).  Session 2: two branching steps on a 2-message channel; the valid reading
;; 5 is sent (and printed), the invalid reading 6 is replaced by a 0 flag.
;; Result: (7 + 8 + 9) + (5 + 0) = 29.
(def main Nat
  (add (total (send_all (vcons 7 (vcons 8 (vcons 9 vnil))) (open_chan 3)))
       (total (close (send_checked (send_checked (open_chan 2) true 5) false 6)))))
